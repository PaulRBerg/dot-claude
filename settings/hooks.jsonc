{
  // Hooks configuration for Claude Code, ordered alphabetically
  // These hooks execute in response to events during Claude Code's operation
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Elicitation": [
      {
        "hooks": [
          {
            "command": "ai-notify event elicitation",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "ai-notify event notification",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],
    // No PermissionRequest hooks: one with any matcher makes Claude Code ignore
    // CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS and prompt again for dangerous rm commands.
    // The Notification hook already reports permission prompts.
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/PostToolUse/add_plan_frontmatter.py",
            "timeout": 10,
            "type": "command",
          },
        ],
        "matcher": "Write",
      },
      {
        "hooks": [
          {
            "async": true,
            "asyncRewake": true,
            "command": "ai-coord waker claude",
            "if": "Bash(ai-coord start *)",
            "timeout": 3600,
            "type": "command",
          },
        ],
        "matcher": "Bash",
      },
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord waker claude",
            "timeout": 3600,
            "if": "Bash(ai-coord start *)",
            "async": true,
            "asyncRewake": true,
          },
        ],
      },
    ],
    "PreToolUse": [
      // These guards stand in for permission rules. A deny or ask rule for Bash, Edit, or Read would bring back
      // Claude Code's prompt for dangerous rm commands (see basics.jsonc), and a hook must answer "deny", not
      // "ask", for a removal. No `if` filters: commands can follow wrappers, assignments, or `bash -c`, which
      // prefix patterns miss.
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "~/.claude/hooks/PreToolUse/command_guard.py",
            "timeout": 5,
            "type": "command",
          },
          {
            "command": "~/.claude/hooks/PreToolUse/git_guard.py",
            "timeout": 5,
            "type": "command",
          },
          {
            "command": "~/.claude/hooks/PreToolUse/guard_rm.py",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
      {
        "matcher": "Bash|Edit|Glob|Grep|NotebookEdit|Read|Write",
        "hooks": [
          {
            "command": "~/.claude/hooks/PreToolUse/path_guard.py",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "command": "ai-notify event ask-user-question",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 3,
          },
        ],
      },
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/SessionStart/enable_computer_use.py",
            "timeout": 5,
            "type": "command",
          },
        ],
        "matcher": "startup",
      },
      // Installed by herdr; keep the command verbatim so herdr recognizes its integration
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/prb/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
          },
        ],
      },
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "ai-notify event stop",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "ai-notify event stop-failure",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/UserPromptSubmit/copy_prompt_to_clipboard.py",
            "timeout": 10,
            "type": "command",
          },
        ],
      },
      {
        "hooks": [
          {
            "command": "ai-notify event user-prompt-submit",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "command": "ai-coord hook claude",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],
  },
}
