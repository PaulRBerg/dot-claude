{
  // Hooks configuration for Claude Code, ordered alphabetically
  // These hooks execute in response to events during Claude Code's operation
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "ai-notify event notification",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "ai-notify event permission-request",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],

    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/PostToolUse/add_plan_frontmatter.py",
            "timeout": 10,
            "type": "command",
          },
        ],
        "matcher": "Write",
      },
      {
        "hooks": [
          {
            "async": true,
            "asyncRewake": true,
            "command": "ai-coord waker claude",
            "if": "Bash(ai-coord start *)",
            "timeout": 3600,
            "type": "command",
          },
        ],
        "matcher": "Bash",
      },
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord waker claude",
            "timeout": 3600,
            "if": "Bash(ai-coord start *)",
            "async": true,
            "asyncRewake": true,
          },
        ],
      },
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "~/.claude/hooks/PreToolUse/guard_rm.py",
            "if": "Bash(rm *)",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            // No `if` filter: git can follow wrappers, assignments, or `bash -c`, which prefix patterns miss.
            "command": "~/.claude/hooks/PreToolUse/git_guard.py",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "command": "ai-notify event ask-user-question",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 3,
          },
        ],
      },
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "ai-notify event stop",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "ai-notify event stop-failure",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/UserPromptSubmit/copy_prompt_to_clipboard.py",
            "timeout": 10,
            "type": "command",
          },
        ],
      },
      {
        "hooks": [
          {
            "command": "ai-notify event user-prompt-submit",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-coord hook claude",
            "timeout": 5,
          },
        ],
      },
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "command": "ai-coord hook claude",
            "timeout": 5,
            "type": "command",
          },
        ],
      },
    ],
  },
}
