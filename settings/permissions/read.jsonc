{
  // Read and Edit denials for sensitive and user-owned files. Bypass mode skips the prompt for edits
  // outside the working directories, so secrets need explicit Edit denials too.
  // NOTE: to add reading directories, use the additional-dirs.jsonc file
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(**/PROMPT.md)",
      "Edit(~/.ssh/**)",
      "Edit(~/Drive/Secrets/**)",
      "Read(**/PROMPT.md)",
      "Read(**/TODO.md)",
      "Read(~/.ssh/**)",
      "Read(~/Drive/Secrets/**)",
    ],
  },
}
